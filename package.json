{
  "name": "psg-smart-campus",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.cjs",
    "start": "next start",
    "lint": "eslint app frontend backend lib tests middleware.ts --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write app frontend backend lib tests db docs *.json *.ts *.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@supabase/supabase-js": "2.117.3",
    "zod": "3.24.2",
    "recharts": "2.15.1",
    "pdf-lib": "1.17.1",
    "exceljs": "4.4.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/node": "22.13.10",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.27",
    "vitest": "3.0.9",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "postcss": "8.5.28",
    "autoprefixer": "10.4.21"
  },
  "overrides": {
    "postcss": "$postcss",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
